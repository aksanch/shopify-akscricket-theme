{% doc %}
  @prompt
    Create a media grid card block that matches the style of existing media grid cards. The card should have a background video that autoplays, is muted, and loops instead of a static image. Overlay the video with a dark semi-transparent layer to ensure text readability. Include customizable settings for: video file upload, title, paragraph description, button label, and button link URL. The card should match the same dimensions and proportions as standard media grid cards so it sits seamlessly within a media grid section.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-media-grid-card-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: {{ settings.roundness_blocks }}px;
    display: block;
  }

  .ai-media-grid-card__video-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-media-grid-card__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-media-grid-card__video-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-media-grid-card__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-media-grid-card__video-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-media-grid-card__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity }});
    z-index: 2;
  }

  .ai-media-grid-card__content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.vertical_alignment }};
    align-items: {{ block.settings.horizontal_alignment }};
    padding: {{ block.settings.content_padding }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-media-grid-card__title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0 0 {{ block.settings.text_spacing }}px;
    line-height: 1.2;
  }

  .ai-media-grid-card__description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_size }}px;
    margin: 0 0 {{ block.settings.button_spacing }}px;
    line-height: 1.5;
    max-width: 600px;
  }

  .ai-media-grid-card__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ settings.roundness_buttons }}px;
    font-size: {{ settings.typography_buttons_base_size }}px;
    font-weight: {{ settings.typography_bold_weight }};
    transition: all 0.3s ease;
    {% if settings.typography_buttons_capitalize %}
      text-transform: uppercase;
    {% endif %}
  }

  .ai-media-grid-card__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .ai-media-grid-card__content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.7 }}px;
    }

    .ai-media-grid-card__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-media-grid-card__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<media-grid-card-{{ ai_gen_id }}
  class="ai-media-grid-card-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-media-grid-card__video-wrapper-{{ ai_gen_id }}">
    {% if block.settings.video_file %}
      <video
        class="ai-media-grid-card__video-{{ ai_gen_id }}"
        autoplay
        muted
        loop
        playsinline
        {% if block.settings.video_poster %}
          poster="{{ block.settings.video_poster | image_url: width: 2000 }}"
        {% endif %}
      >
        {% for source in block.settings.video_file.sources %}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {% endfor %}
      </video>
    {% else %}
      <div class="ai-media-grid-card__video-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-media-grid-card__empty-state-{{ ai_gen_id }}">
          Next, add a video
        </div>
      </div>
    {% endif %}
  </div>

  <div class="ai-media-grid-card__overlay-{{ ai_gen_id }}"></div>

  <div class="ai-media-grid-card__content-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h3 class="ai-media-grid-card__title-{{ ai_gen_id }}">
        {{ block.settings.title }}
      </h3>
    {% endif %}

    {% if block.settings.description != blank %}
      <div class="ai-media-grid-card__description-{{ ai_gen_id }}">
        {{ block.settings.description }}
      </div>
    {% endif %}

    {% if block.settings.button_label != blank and block.settings.button_link != blank %}
      <a
        href="{{ block.settings.button_link }}"
        class="ai-media-grid-card__button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_label }}
      </a>
    {% endif %}
  </div>
</media-grid-card-{{ ai_gen_id }}>

<script>
  (function() {
    class MediaGridCard{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.video = this.querySelector('.ai-media-grid-card__video-{{ ai_gen_id }}');
        if (this.video) {
          this.setupVideo();
        }
      }

      setupVideo() {
        this.video.addEventListener('loadeddata', () => {
          this.video.play().catch(() => {
            console.log('Video autoplay prevented');
          });
        });

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              this.video.play().catch(() => {});
            } else {
              this.video.pause();
            }
          });
        }, { threshold: 0.5 });

        observer.observe(this);
      }
    }

    customElements.define('media-grid-card-{{ ai_gen_id }}', MediaGridCard{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Media grid video card",
  "tag": null,
  "settings": [

{% doc %}
  @prompt
    Create a full-width collection banner section that displays only on the "balls" collection page. The banner should show a background image with text overlaid on top (collection title and optional subtitle/description). It should be conditionally rendered so it only appears when viewing the cricket balls collection (e.g., collection handle is "balls" or "senior-match-balls"). The banner should be full-width, visually striking, and suitable for a cricket equipment store. Include settings for: background image, overlay color/opacity, heading text, subheading text, text color, and banner height.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign show_banner = false
  assign collection_handles = block.settings.collection_handles | split: ','
  
  for handle in collection_handles
    assign trimmed_handle = handle | strip
    if collection.handle == trimmed_handle
      assign show_banner = true
      break
    endif
  endfor
%}

{% if show_banner %}
  {% style %}
    .ai-collection-banner-{{ ai_gen_id }} {
      position: relative;
      width: 100%;
      height: {{ block.settings.banner_height_mobile }}px;
      overflow: hidden;
      display: block;
    }

    @media screen and (min-width: 750px) {
      .ai-collection-banner-{{ ai_gen_id }} {
        height: {{ block.settings.banner_height }}px;
      }
    }

    .ai-collection-banner-image-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .ai-collection-banner-placeholder-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: #f4f4f4;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .ai-collection-banner-placeholder-{{ ai_gen_id }} svg {
      width: 100%;
      height: 100%;
      max-width: 500px;
      max-height: 500px;
    }

    .ai-collection-banner-overlay-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: {{ block.settings.overlay_color }};
      opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    }

    .ai-collection-banner-content-{{ ai_gen_id }} {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: {{ block.settings.text_alignment }};
      justify-content: {{ block.settings.vertical_alignment }};
      height: 100%;
      max-width: {{ block.settings.content_max_width }}px;
      margin: 0 auto;
      padding: 40px 20px;
      text-align: {{ block.settings.text_alignment }};
    }

    @media screen and (min-width: 750px) {
      .ai-collection-banner-content-{{ ai_gen_id }} {
        padding: 60px 40px;
      }
    }

    .ai-collection-banner-heading-{{ ai_gen_id }} {
      color: {{ block.settings.text_color }};
      font-size: {{ block.settings.heading_size_mobile }}px;
      margin: 0 0 16px;
      line-height: 1.2;
    }

    @media screen and (min-width: 750px) {
      .ai-collection-banner-heading-{{ ai_gen_id }} {
        font-size: {{ block.settings.heading_size }}px;
      }
    }

    .ai-collection-banner-subheading-{{ ai_gen_id }} {
      color: {{ block.settings.text_color }};
      font-size: {{ block.settings.subheading_size_mobile }}px;
      margin: 0;
      line-height: 1.5;
      max-width: 600px;
    }

    @media screen and (min-width: 750px) {
      .ai-collection-banner-subheading-{{ ai_gen_id }} {
        font-size: {{ block.settings.subheading_size }}px;
      }
    }

    .ai-collection-banner-empty-state-{{ ai_gen_id }} {
      position: absolute;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      padding: 12px 20px;
      font-size: 14px;
      color: #666;
      text-align: center;
      pointer-events: none;
      z-index: 3;
    }
  {% endstyle %}

  <collection-banner-{{ ai_gen_id }}
    class="ai-collection-banner-{{ ai_gen_id }}"
    {{ block.shopify_attributes }}
  >
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
        class="ai-collection-banner-image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-collection-banner-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
      <div class="ai-collection-banner-empty-state-{{ ai_gen_id }}">
        Next, add a background image
      </div>
    {% endif %}

    <div class="ai-collection-banner-overlay-{{ ai_gen_id }}"></div>

    <div class="ai-collection-banner-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h1 class="ai-collection-banner-heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h1>
      {% elsif collection.title %}
        <h1 class="ai-collection-banner-heading-{{ ai_gen_id }}">
          {{ collection.title }}
        </h1>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <div class="ai-collection-banner-subheading-{{ ai_gen_id }}">
          {{ block.settings.subheading }}
        </div>
      {% elsif collection.description != blank %}
        <div class="ai-collection-banner-subheading-{{ ai_gen_id }}">
          {{ collection.description }}
        </div>
      {% endif %}
    </div>
  </collection-banner-{{ ai_gen_id }}>
{% endif %}

{% schema %}
{
  "name": "Collection banner",
  "settings": [
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "paragraph",
      "content": "Enter collection handles separated by commas (e.g., balls, senior-match-balls)"
    },
    {
      "type": "text",
      "id": "collection_handles",
      "label": "Collection handles",
      "default": "balls"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Desktop height",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "banner_height_mobile",
      "label": "Mobile height",
      "min": 150,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 300
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Desktop heading size",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Mobile heading size",
      "min": 20,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Desktop subheading size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "label": "Mobile subheading size",
      "min": 12,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 600,
      "max": 1500,
      "step": 50,
      "unit": "px",
      "default": 1200
    }
  ],
  "presets": [
    {
      "name": "Collection banner"
    }
  ]
}
{% endschema %}
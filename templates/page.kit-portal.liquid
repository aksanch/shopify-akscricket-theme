  <div class="sn-cart-ftr">
    <div class="sn-cart-total"><span>Total</span><span id="snCartTotal">$0.00</span></div>
    <button type="button" class="sn-chk-btn" id="snChkBtn">Proceed to Checkout →</button>
  </div>
</div>

<button type="button" class="sn-sticky" id="snSticky">View Order <span class="sn-sticky-badge" id="snBadge">0</span></button>

<div class="sn-toast" id="snToast"></div>

</div>

<script>
(function(){

const PRODUCT_CONFIG = [
  { handle: "v-neck-singlet-black",                cat: "singlet",  age: "adult", hasNN: true,  tag: "Game Day Singlet" },
  { handle: "v-neck-singlet-black-kids",           cat: "singlet",  age: "kids",  hasNN: true,  tag: "Game Day Singlet" },
  { handle: "v-neck-singlet-red",                  cat: "singlet",  age: "adult", hasNN: true,  tag: "Game Day Singlet" },
  { handle: "v-neck-singlet-red-kids",             cat: "singlet",  age: "kids",  hasNN: true,  tag: "Game Day Singlet" },
  { handle: "training-shirt-red",                  cat: "training", age: "adult", hasNN: true,  tag: "Training Shirt" },
  { handle: "training-shirt-red-kids",             cat: "training", age: "kids",  hasNN: true,  tag: "Training Shirt" },
  { handle: "training-shirt-black",                cat: "training", age: "adult", hasNN: true,  tag: "Training Shirt" },
  { handle: "training-shirt-black-kids",           cat: "training", age: "kids",  hasNN: true,  tag: "Training Shirt" },
  { handle: "training-shirt-cross-design",         cat: "training", age: "adult", hasNN: false, tag: "Training Shirt" },
  { handle: "training-shirt-cross-design-kids",    cat: "training", age: "kids",  hasNN: false, tag: "Training Shirt" },
  { handle: "training-shirt-sponsor-edition",      cat: "training", age: "adult", hasNN: false, tag: "Polo Shirt" },
  { handle: "training-shirt-sponsor-edition-kids", cat: "training", age: "kids",  hasNN: false, tag: "Polo Shirt" },
  { handle: "womens-cut-singlet",                  cat: "womens",   age: "adult", hasNN: false, tag: "Women's Singlet" },
];

let products=[],cart=[],current=null,activeFilter="all",selectedVariantId=null,selectedSize="",qty=1;

function snParseVariantTitle(title){
  if(!title || title === "Default Title") return {group:"", size:title||""};
  const m = title.match(/^(Adult|Kids|Womens)\s+(.+)$/i);
  if(m) return {group: m[1], size: m[2]};
  return {group:"", size:title};
}

function snShortDesc(text){
  if(!text) return "";
  text = text.replace(/<[^>]+>/g,' ').replace(/\s+/g,' ').trim();
  if(text.length <= 60) return text;
  return text.substring(0,57).trim()+"...";
}

async function snLoadProducts(){
  const promises = PRODUCT_CONFIG.map(cfg =>
    fetch('/products/'+cfg.handle+'.js', {headers:{'Accept':'application/json'}})
      .then(r => r.ok ? r.json() : null)
      .then(data => {
        if(!data) return null;
        return {
          handle: cfg.handle, cat: cfg.cat, age: cfg.age, hasNN: cfg.hasNN, tag: cfg.tag,
          title: data.title,
          description: data.description,
          bodyHtml: data.body_html || data.description,
          price: data.price/100,
          image: data.featured_image || (data.images && data.images[0]) || "",
          variants: data.variants.map(v => ({
            id: v.id, title: v.title, available: v.available, price: v.price/100,
            ...snParseVariantTitle(v.title)
          }))
        };
      })
      .catch(()=>null)
  );
  const results = await Promise.all(promises);
  products = results.filter(p => p !== null);
  console.log('Loaded '+products.length+' products');
  if(products.length === 0){
    document.getElementById("snGrid").innerHTML = '<div class="sn-loading-grid">Could not load products. Make sure all products are published to your Online Store.</div>';
    return;
  }
  snRenderGrid();
}

function snRenderGrid(){
  let items;
  if(activeFilter === "all") items = products;
  else if(activeFilter === "kids") items = products.filter(p => p.age === "kids");
  else items = products.filter(p => p.cat === activeFilter);
  document.getElementById("snSecCount").textContent = items.length+" item"+(items.length!==1?"s":"");
  if(!items.length){
    document.getElementById("snGrid").innerHTML = '<div class="sn-loading-grid">No products in this category.</div>';
    return;
  }
  const grid = document.getElementById("snGrid");
  grid.innerHTML = "";
  items.forEach(p => {
    const desc = snShortDesc(p.description);
    const card = document.createElement("div");
    card.className = "sn-card";
    card.innerHTML =
      '<div class="sn-card-img">'+
        (p.hasNN?'<div class="sn-nn-badge">Custom Name &amp; #</div>':'')+
        '<img src="'+p.image+'" alt="" loading="lazy">'+
        '<div class="sn-card-cta">Quick Order →</div>'+
      '</div>'+
      '<div class="sn-card-body">'+
        '<div class="sn-card-cat">'+p.tag+'</div>'+
        '<div class="sn-card-name"></div>'+
        '<div class="sn-card-desc">'+(desc||'&nbsp;')+'</div>'+
        '<div class="sn-card-foot"><div></div><div class="sn-card-price">$'+p.price.toFixed(2)+'</div></div>'+
      '</div>';
    card.querySelector('.sn-card-name').textContent = p.title;
    card.addEventListener('click', ()=>snOpenModal(p.handle));
    grid.appendChild(card);
  });
}

function snFilter(cat, btn){
  activeFilter = cat;
  document.querySelectorAll(".sn-fbtn").forEach(b=>b.classList.remove("sn-active"));
  btn.classList.add("sn-active");
  const labels={all:"2026 Season Collection",singlet:"Game Day Singlets",training:"Training Shirts",womens:"Women's Collection",kids:"Kids Collection"};
  document.getElementById("snSecTitle").textContent = labels[cat];
  snRenderGrid();
}

function snRenderSizes(p){
  const groups = {};
  p.variants.forEach(v => {
    const key = v.group || "Size";
    if(!groups[key]) groups[key] = [];
    groups[key].push(v);
  });
  const grid = document.getElementById("snSizeGrid");
  grid.innerHTML = "";
  const order = ["Adult","Womens","Kids"];
  const orderedKeys = [...order.filter(k=>groups[k]), ...Object.keys(groups).filter(k=>!order.includes(k))];
  orderedKeys.forEach(key => {
    if(p.variants.length>1 || groups[key][0].group){
      const lbl = document.createElement("div");
      lbl.className = "sn-size-group-label";
      lbl.textContent = key;
      grid.appendChild(lbl);
    }
    groups[key].forEach(v=>{
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "sn-size-btn";
      btn.textContent = v.size || v.title;
      if(!v.available){btn.disabled=true;btn.title="Sold out";}
      btn.addEventListener('click', ()=>{
        document.querySelectorAll(".sn-size-btn").forEach(b=>b.classList.remove("sn-selected"));
        btn.classList.add("sn-selected");
        selectedVariantId = v.id;
        selectedSize = (v.group?v.group+' ':'')+(v.size||v.title);
        document.getElementById("snSizeErr").textContent = "";
      });
      grid.appendChild(btn);
    });
  });
  selectedVariantId=null; selectedSize="";
}

function snOpenModal(handle){
  const p = products.find(x=>x.handle===handle);
  if(!p) return;
  current=p; selectedVariantId=null; selectedSize=""; qty=1;
  document.getElementById("snMImg").src = p.image;
  document.getElementById("snMCat").textContent = p.tag;
  document.getElementById("snMTitle").textContent = p.title;
  document.getElementById("snMFabric").innerHTML = p.bodyHtml||"";
  document.getElementById("snMPrice").textContent = "$"+p.price.toFixed(2);
  document.getElementById("snQtyVal").textContent = "1";
  document.getElementById("snSizeErr").textContent = "";
  document.getElementById("snNNErr").textContent = "";
  snRenderSizes(p);
  document.getElementById("snNNBlock").style.display = p.hasNN?"block":"none";
  document.getElementById("snPName").value = "";
  document.getElementById("snPNum").value = "";
  document.getElementById("snNameHint").textContent = "0 / 14 characters";
  document.getElementById("snPreview").classList.remove("sn-on");
  document.getElementById("snModalOv").classList.add("sn-open");
  document.body.style.overflow = "hidden";
}

function snCloseModal(){
  document.getElementById("snModalOv").classList.remove("sn-open");
  document.body.style.overflow = "";
}

function snUpdatePreview(){
  const name = document.getElementById("snPName").value.toUpperCase();
  const num = document.getElementById("snPNum").value;
  document.getElementById("snNameHint").textContent = name.length+" / 14 characters";
  const p = document.getElementById("snPreview");
  if(name||num){
    document.getElementById("snPrevName").textContent = name||"—";
    document.getElementById("snPrevNum").textContent = num?"#"+num:"";
    p.classList.add("sn-on");
  } else p.classList.remove("sn-on");
}

async function snAddToCart(){
  const p = current;
  if(!selectedVariantId){document.getElementById("snSizeErr").textContent="Please select a size";return;}
  const name = p.hasNN?document.getElementById("snPName").value.toUpperCase().trim():"";
  const num = p.hasNN?document.getElementById("snPNum").value.trim():"";
  if(p.hasNN&&!name){document.getElementById("snNNErr").textContent="Please enter a player name";return;}
  if(p.hasNN&&!num){document.getElementById("snNNErr").textContent="Please enter a player number";return;}
  document.getElementById("snNNErr").textContent = "";
  const properties = {};
  if(p.hasNN){properties["Player Name"]=name;properties["Player Number"]=num;}
  const btn = document.getElementById("snAddBtn");
  btn.disabled = true;
  btn.innerHTML = '<span class="sn-loading"></span> Adding...';
  try {
    const res = await fetch("/cart/add.js", {
      method:"POST", headers:{"Content-Type":"application/json","Accept":"application/json"},
      body: JSON.stringify({items:[{id:selectedVariantId, quantity:qty, properties:properties}]})
    });
    if(!res.ok){
      const err = await res.json().catch(()=>({}));
      throw new Error(err.description||err.message||"Failed to add to cart");
    }
    snCloseModal();
    await snRefreshCart();
    document.getElementById("snCartPanel").classList.add("sn-open");
    document.getElementById("snCartOv").classList.add("sn-open");
    snShowToast("Added to order!");
  } catch(e) {
    snShowToast("Could not add to cart: "+e.message);
  } finally {
    btn.disabled = false;
    btn.textContent = "Add to Order";
  }
}

async function snRefreshCart(){
  try {
    const res = await fetch("/cart.js", {headers:{'Accept':'application/json'}});
    if(!res.ok) throw new Error("Cart fetch failed");
    const data = await res.json();
    cart = data.items.map(i => ({
      key: i.key, name: i.product_title,
      size: (i.variant_options && i.variant_options[0]) || i.variant_title || "",
      qty: i.quantity, price: i.price/100, linePrice: i.line_price/100,
      properties: i.properties || {}
    }));
    snRenderCart();
  } catch(e){console.error("Cart refresh failed", e);}
}

function snRenderCart(){
  const total = cart.reduce((a,i)=>a+i.linePrice,0);
  const totalQty = cart.reduce((a,i)=>a+i.qty,0);
  document.getElementById("snBadge").textContent = totalQty;
  document.getElementById("snCartTotal").textContent = "$"+total.toFixed(2);
  const body = document.getElementById("snCartBody");
  if(!cart.length){
    body.innerHTML = '<div class="sn-cart-empty">No items yet.<br>Browse the collection above.</div>';
    return;
  }
  body.innerHTML = "";
  cart.forEach(i => {
    const pn = i.properties["Player Name"];
    const pNum = i.properties["Player Number"];
    const div = document.createElement("div");
    div.className = "sn-ci";
    div.innerHTML =
      '<div class="sn-ci-name"></div>'+
      '<div class="sn-ci-meta">Size: '+i.size+' · Qty: '+i.qty+'</div>'+
      (pn?'<div class="sn-ci-nn">Name: '+pn+' · #'+(pNum||"")+'</div>':'')+
      '<div class="sn-ci-price">$'+i.linePrice.toFixed(2)+'</div>'+
      '<button type="button" class="sn-ci-rm">Remove</button>';
    div.querySelector('.sn-ci-name').textContent = i.name;
    div.querySelector('.sn-ci-rm').addEventListener('click', ()=>snRemoveItem(i.key));
    body.appendChild(div);
  });
}

async function snRemoveItem(key){
  try {
    await fetch("/cart/change.js", {
      method:"POST", headers:{"Content-Type":"application/json","Accept":"application/json"},
      body: JSON.stringify({id:key, quantity:0})
    });
    await snRefreshCart();
  } catch(e){snShowToast("Could not remove item");}
}

function snToggleCart(){
  document.getElementById("snCartPanel").classList.toggle("sn-open");
  document.getElementById("snCartOv").classList.toggle("sn-open");
}

let snTT;
function snShowToast(msg){
  const t = document.getElementById("snToast");
  t.textContent = msg;
  t.classList.add("sn-show");
  clearTimeout(snTT);
  snTT = setTimeout(()=>t.classList.remove("sn-show"), 2800);
}

// Wire up event listeners
document.querySelectorAll('.sn-fbtn').forEach(btn => {
  btn.addEventListener('click', ()=>snFilter(btn.dataset.filter, btn));
});
document.getElementById('snMClose').addEventListener('click', snCloseModal);
document.getElementById('snModalOv').addEventListener('click', e=>{
  if(e.target.id==='snModalOv') snCloseModal();
});
document.getElementById('snQtyMinus').addEventListener('click', ()=>{
  qty=Math.max(1,Math.min(20,qty-1));
  document.getElementById("snQtyVal").textContent=qty;
});
document.getElementById('snQtyPlus').addEventListener('click', ()=>{
  qty=Math.max(1,Math.min(20,qty+1));
  document.getElementById("snQtyVal").textContent=qty;
});
document.getElementById('snPName').addEventListener('input', snUpdatePreview);
document.getElementById('snPNum').addEventListener('input', snUpdatePreview);
document.getElementById('snAddBtn').addEventListener('click', snAddToCart);
document.getElementById('snCartClose').addEventListener('click', snToggleCart);
document.getElementById('snCartOv').addEventListener('click', snToggleCart);
document.getElementById('snSticky').addEventListener('click', snToggleCart);
document.getElementById('snChkBtn').addEventListener('click', ()=>{
  if(!cart.length){snShowToast("Your order is empty");return;}
  const btn = document.getElementById("snChkBtn");
  btn.disabled = true;
  btn.innerHTML = '<span class="sn-loading"></span> Redirecting...';
  window.location.href = "/checkout";
});

snLoadProducts().then(()=>snRefreshCart());
})();
</script>